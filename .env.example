# Docker Compose에서 참조하는 환경변수 (배포 서버에서 cp .env.example .env 후 값 채우기)
# 이 파일은 Git에 포함됩니다. 실제 비밀번호는 .env에만 넣고 .env는 커밋하지 마세요.

# DB 비밀번호 (backend·db 서비스 공통)
POSTGRES_PASSWORD=new_ibm2

# 배포 시 JWT 서명 키 (32자 이상, 선택)
# JWT_SECRET=랜덤_32자_이상

# 배포 시 프론트 도메인 (빌드 시 build-arg로 전달, docker-compose.yml의 frontend.build.args 참고)
# NEXT_PUBLIC_API_URL=https://your-domain.com
# BACKEND_URL=http://backend:8011
