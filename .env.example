# Docker Compose에서 참조 (배포 서버: cp .env.example .env 후 값 수정)
# .env는 Git 제외. 비밀번호는 .env에만 두세요.

# DB 비밀번호 (backend·db 공통). docker-compose가 읽음.
POSTGRES_PASSWORD=비밀번호_입력

# DB 호스트 포트. 미설정 시 5411. 서버 공유 시 사람마다 다르게 (5411, 5412...)
# POSTGRES_PORT=5411

# 프론트/백엔드 호스트 포트. 서버 공유 시 3011·8011 사용 중이면 .env에 다른 포트 지정
# FRONTEND_PORT=3011
# BACKEND_PORT=8011

# JWT 서명 키 (32자 이상, 선택)
# JWT_SECRET=랜덤_32자_이상

# 프론트 도메인/백엔드 URL은 docker-compose.yml의 frontend.build.args 에서 수정
# NEXT_PUBLIC_API_URL=https://your-domain.com
# BACKEND_URL=http://backend:8011
